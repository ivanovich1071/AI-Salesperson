# === OpenRouter ===
# Ключ НЕ коммитить. Получить: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Основная текстовая модель (генерация вопросов, предложений, ответов на возражения)
OPENROUTER_MODEL=qwen/qwen3-235b-a22b-2507

# Модель распознавания речи (Whisper Large V3 через OpenRouter)
OPENROUTER_WHISPER_MODEL=openai/whisper-large-v3

# === База данных (SQLite + Prisma) ===
DATABASE_URL="file:./dev.db"

# === Админка ===
ADMIN_USER=admin
ADMIN_PASSWORD=demo2026
# Произвольная строка для подписи cookie сессии админа
ADMIN_SESSION_SECRET=change-me-random-string

# === Уведомления в Telegram ===
# Токен бота от @BotFather (/newbot). Не коммитить.
TELEGRAM_BOT_TOKEN=
# Куда слать уведомления: id личного чата или группы.
# Узнать: написать боту любое сообщение и запустить
#   node scripts/telegram-setup.mjs
# Несколько получателей — через запятую.
TELEGRAM_CHAT_ID=
# Уведомлять ли о пройденных диагностиках (не только о бронях): on | off
TELEGRAM_NOTIFY_DIAGNOSTICS=on

# === Прочее ===
# Публичный URL сайта: метатеги, canonical, sitemap.xml, robots.txt, JSON-LD и
# llms.txt. ВАЖНО: значение вшивается на СБОРКЕ. Если в проде оставить localhost,
# краулеры поисковиков и ИИ уйдут по локальным адресам и сайт выпадет из выдачи.
# Проверка после деплоя: npm run geo:audit -- https://vibemind.by
# В проде: https://vibemind.by
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Коды подтверждения прав на сайт. Нужны, чтобы отправить sitemap и следить за
# индексацией. Берутся в Google Search Console и Яндекс.Вебмастере (вариант
# подтверждения «мета-тег»); в тег подставляется только значение content.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
