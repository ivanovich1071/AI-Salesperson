generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Свободный слот для встречи с экспертом
model TimeSlot {
  id        String    @id @default(cuid())
  date      String // YYYY-MM-DD
  time      String // HH:MM
  isBooked  Boolean   @default(false)
  createdAt DateTime  @default(now())
  booking   Booking?

  @@unique([date, time])
}

// Забронированная встреча + сводка AI-диагностики
model Booking {
  id         String   @id @default(cuid())
  slotId     String   @unique
  slot       TimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  name       String
  company    String
  email      String
  phone      String

  // Сводка визарда (JSON-строка): роль, цели, ответы диагностики,
  // рекомендованные модули, стоимость, возражение
  summary    String   @default("{}")
  totalCost  Int      @default(0)
  status     String   @default("booked") // booked | done | cancelled
  createdAt  DateTime @default(now())
}

// Карточка витрины «Лаборатория решений» (/solutions). Правится в админке,
// стартовый набор заливает scripts/seed-lab.mjs из src/lib/lab/defaults.json.
model LabSolution {
  id          String   @id @default(cuid())
  name        String
  role        String
  task        String
  abilities   String   @default("[]") // JSON-массив строк: «Что умеет»
  tags        String   @default("[]") // JSON-массив строк
  status      String // текст плашки: «Живое демо», «Готов к внедрению»…
  tone        String   @default("ready") // цвет плашки: live | partner | ready | github | soon
  liveUrl     String?
  liveLabel   String?
  note        String?
  icon        String   @default("lab") // иконка для карточки без фото (src/components/lab/icons.ts)
  photo       String? // /images/lab/… (из репозитория) или /uploads/lab/… (загружено в админке)
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  updatedBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Карта диагностики клиента (шаблон-заготовка). Сохраняется в момент
// формирования предложения — до/без брони встречи. Виден в админке.
model DiagnosticMap {
  id               String   @id @default(cuid())
  companyName      String
  userRole         String
  participantCount Int      @default(0)
  goals            String   @default("")

  // JSON-строка: ответы анкеты (qid→{selected,other}), свободные заметки из чата,
  // краткая сводка предложения, модули, часы, стоимость обучения
  data             String   @default("{}")
  matchScore       Int      @default(0)
  createdAt        DateTime @default(now())
}
